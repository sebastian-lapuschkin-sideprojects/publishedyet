	shorttitle = {Enhancing transparency and trust in {AI}-powered manufacturing},
	abstract = {Explainable Artificial Intelligence ({XAI}) is crucial for the transition from the fourth to fifth industrial revolution, providing transparency and fostering user confidence in Artificial Intelligence ({AI}) powered systems. Since 2020, {XAI} applications demonstrate potential to transform manufacturing. This paper provides an extensive overview of {XAI}-based applications in Industries 4.0 and 5.0 by highlighting the trends regarding methods used, connecting {XAI} methods with important parameters and presenting {XAI} visualization approaches. The survey provides valuable insights for researchers, practitioners and industry leaders as it underscores the potential of {XAI} in shaping the future of manufacturing by enhancing transparency and user acceptance of {AI}-powered applications.},
